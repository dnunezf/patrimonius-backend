{
  "name": "patrimonius-backend",
  "version": "1.0.0",
  "description": "patrimonius-backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "cross-env NODE_ENV=test AUTH_DISABLED=true SEED_PLANTILLAS=false NODE_OPTIONS=--experimental-vm-modules jest -c jest.config.mjs",
    "test:hu025:junit": "cross-env NODE_ENV=test AUTH_DISABLED=true SEED_PLANTILLAS=false NODE_OPTIONS=--experimental-vm-modules JEST_JUNIT_OUTPUT_NAME=hu025-junit.xml jest -c jest.config.mjs --testPathPatterns=hu025",
    "lint": "eslint . --ext .js,.mjs",
    "build": "echo 'No build required for Node.js backend'"
  },
  "author": "grupo08",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.4",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "html-to-docx": "^1.8.0",
    "js2xmlparser": "^5.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.1",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.3",
    "node-signpdf": "^3.0.0",
    "nodemailer": "^7.0.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pino": "^9.9.0",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.38.0",
    "socket.io": "^4.8.1",
    "ws": "^8.18.3",
    "y-websocket": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.3.0",
    "cross-env": "^10.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^15.0.0",
    "jsdom": "^26.0.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|mjs)$": "babel-jest",
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!supertest)"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "mjs",
      "ts",
      "node"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
    },
    "extensionsToTreatAsEsm": [
      ".mjs",
      ".js"
    ]
  }
}
